# Copie este arquivo para ".env.local" (na mesma pasta) e preencha os
# valores. O ".env.local" nunca é enviado para o GitHub (já está no
# .gitignore) — é só para a sua máquina e, depois, para as variáveis de
# ambiente da Netlify.

# Painel do Supabase > Settings > API
# URL do projeto (não é segredo, pode ficar exposta no navegador)
NEXT_PUBLIC_SUPABASE_URL=

# Painel do Supabase > Settings > API > "anon public" key
# Também não é segredo — é a chave que o navegador do visitante usa,
# protegida pelas regras de RLS do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel do Supabase > Settings > API > "service_role" key
# ATENÇÃO: isso É segredo. Nunca aparece no navegador, nunca vai para o
# GitHub, só é usada em código que roda no servidor (ex.: gerar link de
# download assinado, processar webhook de pagamento).
SUPABASE_SERVICE_ROLE_KEY=

# Endereço em que o site está rodando. Em desenvolvimento é sempre este
# valor; em produção (Netlify) vira "https://acervolobeira.com.br".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PENDENTE — só existe depois que a conta da Kiwify estiver pronta.
# É o "token" que aparece quando você cria um webhook no painel da
# Kiwify (Apps > Webhooks > Criar webhook). Até lá, deixe em branco:
# o site funciona normalmente, só o endpoint de webhook real fica
# desativado (use a simulação em /admin/pagamentos nesse meio tempo).
KIWIFY_WEBHOOK_TOKEN=
